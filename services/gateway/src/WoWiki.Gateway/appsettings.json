{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:8080",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10485760
    }
  },
  "Security": {
    "RedirectToHttps": false,
    "UseHsts": false
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": []
  },
  "RateLimiting": {
    "PermitLimit": 300,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Order": 0,
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "pdf": {
        "ClusterId": "pdf",
        "Order": 0,
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/pdf/{**catch-all}"
        }
      },
      "backend-api": {
        "ClusterId": "backend",
        "Order": 10,
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "backend-images": {
        "ClusterId": "backend",
        "Order": 10,
        "Match": {
          "Path": "/images/{**catch-all}"
        }
      },
      "frontend": {
        "ClusterId": "frontend",
        "Order": 100,
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "frontend": {
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        },
        "Destinations": {
          "development": {
            "Address": "http://localhost:3000/"
          }
        }
      },
      "backend": {
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        },
        "Destinations": {
          "development": {
            "Address": "http://localhost:5000/"
          }
        }
      },
      "auth": {
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        },
        "Destinations": {
          "development": {
            "Address": "http://localhost:5100/"
          }
        }
      },
      "pdf": {
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        },
        "Destinations": {
          "development": {
            "Address": "http://localhost:5200/"
          }
        }
      }
    }
  }
}
